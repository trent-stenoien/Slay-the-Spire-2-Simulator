{
  "name": "slay-the-spire-2-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "compare-main": "node tools/compare-main.mjs",
    "shot": "node tools/shot.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{engine,app,data,tools}/**/*.{ts,tsx,js,mjs,css,json}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"{engine,app,data,tools}/**/*.{ts,tsx,js,mjs,css,json}\" \"*.{js,ts,json}\""
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
